#!/usr/bin/env bash
# homelab-watch — sonde de supervision minimale pour le Pi 5 "server".
#
# Pourquoi en systemd et NON en CronJob Kubernetes :
# la panne du 2026-07-19 avait fige le kubelet. Un CronJob n'aurait jamais
# demarre et aucune alerte ne serait partie. Une sonde doit etre EXTERIEURE
# a ce qu'elle surveille.
#
# Machine a etats anti-spam : une anomalie doit persister GRACE secondes avant
# d'alerter, puis rappel toutes les REMINDER secondes, puis message de
# retablissement quand elle disparait.
#
# Usage :
#   homelab-watch [--dry-run] [--heartbeat]   passage normal (timer, 10 min)
#   homelab-watch [--dry-run] --unit-failed <unite>
#                    appele par homelab-notify@<unite>.service (OnFailure=)
# --dry-run   n'envoie rien, affiche les notifications sur la sortie standard
# --heartbeat force le battement de coeur quotidien, quelle que soit l'heure
# Tester sans polluer l'etat reel : STATE_DIR=<dossier jetable> CONF=/dev/null

set -uo pipefail

CONF="${CONF:-/etc/homelab-watch.conf}"
STATE_DIR="${STATE_DIR:-/var/lib/homelab-watch}"
STATE="$STATE_DIR/alerts.state"
export KUBECONFIG=/etc/rancher/k3s/k3s.yaml

# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"
NTFY_URL="${NTFY_URL:-https://ntfy.sh}"
NTFY_TOPIC="${NTFY_TOPIC:-}"
REMINDER="${REMINDER:-21600}"     # 6 h
DISK_MAX="${DISK_MAX:-90}"        # %
TEMP_MAX="${TEMP_MAX:-80}"        # °C
HEARTBEAT_HOUR="${HEARTBEAT_HOUR:-9}"                 # heure locale du message quotidien
DB_BACKUP_DIR="${DB_BACKUP_DIR:-/var/backups/homelab/db}"
DB_BACKUP_MAX_AGE="${DB_BACKUP_MAX_AGE:-129600}"      # 36 h

NOW=$(date +%s)
mkdir -p "$STATE_DIR"; touch "$STATE"
NEWSTATE=$(mktemp); trap 'rm -f "$NEWSTATE"' EXIT

DRY=0; FORCE_HB=0; FAILED_UNIT=""
while (( $# )); do
  case $1 in
    --dry-run)     DRY=1 ;;
    --heartbeat)   FORCE_HB=1 ;;
    --unit-failed)
      # Sans nom d'unite, on lancerait un passage periodique REEL en
      # concurrence avec le timer : refuser.
      [[ -n ${2:-} && $2 != -* ]] || { echo "--unit-failed exige un nom d'unite" >&2; exit 2; }
      FAILED_UNIT=$2; shift ;;
    *) echo "option inconnue : $1" >&2; exit 2 ;;
  esac
  shift
done

notify() { # $1=priorite $2=tags $3=titre $4=corps
  if [[ $DRY == 1 ]]; then printf '[DRY] %s | %s | %s\n' "$1" "$3" "$4"; return; fi
  [[ -z $NTFY_TOPIC ]] && { echo "NTFY_TOPIC vide" >&2; return 1; }
  # --fail : un refus HTTP (429, 5xx) rend un code d'erreur, pour que le
  # battement de coeur sache qu'il doit retenter. 15 s x 2 essais au plus :
  # plusieurs envois dans un meme passage restent sous TimeoutStartSec=120,
  # sinon le service serait tue avant d'enregistrer l'etat.
  curl -sf -o /dev/null --max-time 15 --retry 1 \
    -H "Title: $3" -H "Priority: $1" -H "Tags: $2" \
    -d "$4" "$NTFY_URL/$NTFY_TOPIC"
}

ISSUES=()   # "CLE<TAB>grace<TAB>message"
add() { ISSUES+=("$1	$2	$3"); }

# ── Mode OnFailure= : une unite surveillee vient d'echouer ─────────────────
# Lance par homelab-notify@<unite>.service. systemd transmet MONITOR_* a
# l'unite declenchee (systemd >= 251) ; a defaut (lancement manuel), on
# retombe sur les dernieres lignes du journal de l'unite. L'etat d'alerte
# n'est ni lu ni modifie : ce mode peut tourner en meme temps que le passage
# periodique.
if [[ -n $FAILED_UNIT ]]; then
  inv=${MONITOR_INVOCATION_ID:-}
  if [[ -n $inv ]]; then
    logs=$(journalctl --no-pager -o cat _SYSTEMD_INVOCATION_ID="$inv" + INVOCATION_ID="$inv" 2>/dev/null | tail -n 12)
  else
    logs=$(journalctl --no-pager -o cat -u "$FAILED_UNIT" -n 12 2>/dev/null)
  fi
  notify urgent rotating_light "Echec : $FAILED_UNIT" \
"Resultat : ${MONITOR_SERVICE_RESULT:-inconnu} (${MONITOR_EXIT_CODE:-?} ${MONITOR_EXIT_STATUS:-?}).
$(cut -c1-200 <<<"$logs")
Detail : journalctl -u $FAILED_UNIT -n 50"
  exit
fi

# ── 1. Horloge — la cause racine de la panne des 19 jours ──────────────────
if [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) != yes ]]; then
  add CLOCK 900 "Horloge non synchronisee (NTP). Risque de rejeu de seconde murale au prochain boot."
fi

# ── 2. Le service k3s lui-meme ────────────────────────────────────────────
if ! systemctl is-active --quiet k3s; then
  add K3S 300 "Le service k3s n'est pas actif."
else
  # ── 3. La signature EXACTE de la panne de juillet ───────────────────────
  n=$(journalctl -u k3s --since "-20 min" --no-pager 2>/dev/null | grep -c 'is reserved for')
  if (( n > 5 )); then
    add CRILOOP 600 "Boucle CRI 'failed to reserve container name' : $n occurrences en 20 min. C'est la panne du 19/07. Remede : k3s crictl rm <id du conteneur EXITED>."
  fi

  # ── 4. Noeuds ──────────────────────────────────────────────────────────
  bad=$(kubectl get nodes --no-headers 2>/dev/null | awk '$2!="Ready"{printf "%s(%s) ",$1,$2}')
  [[ -n $bad ]] && add NODE 300 "Noeud non Ready : $bad"

  # ── 5. Pods ────────────────────────────────────────────────────────────
  bad=$(kubectl get pods -A --no-headers 2>/dev/null | awk '
    $4=="Completed"||$4=="Succeeded"{next}
    {split($3,r,"/"); if (r[1]!=r[2] || $4!="Running") printf "%s/%s(%s) ",$1,$2,$4}')
  [[ -n $bad ]] && add POD 900 "Pod(s) non Ready depuis >15 min : $bad"

  # ── 6. ArgoCD ──────────────────────────────────────────────────────────
  bad=$(kubectl get applications -n argocd --no-headers \
        -o custom-columns='N:.metadata.name,S:.status.sync.status,H:.status.health.status' 2>/dev/null \
        | awk 'NR>0 && ($2!="Synced"||$3!="Healthy"){printf "%s(%s/%s) ",$1,$2,$3}')
  [[ -n $bad ]] && add ARGOCD 3600 "App(s) ArgoCD dérivée(s) depuis >1 h : $bad"

  # ── 14. argocd-image-updater ───────────────────────────────────────────
  # Un echec d'ecriture Git (deploy key revoquee, known_hosts, secret mal
  # forme) laisse toutes les apps Synced/Healthy : seule la condition Error de
  # la CR ImageUpdater le montre. 1 h de grace : un 429 du registre passe seul.
  bad=$(kubectl --request-timeout=20s get imageupdaters.argocd-image-updater.argoproj.io -n argocd \
        -o jsonpath='{range .items[*]}{.metadata.name}{"|"}{.status.conditions[?(@.type=="Error")].status}{"|"}{.status.conditions[?(@.type=="Error")].message}{"\n"}{end}' 2>/dev/null \
        | awk -F'|' '$2=="True"{printf "%s(%s) ",$1,$3}')
  [[ -n $bad ]] && add IMGUPD 3600 "argocd-image-updater en erreur depuis >1 h : $bad— ecriture Git (cle SSH, deploy key) ou registre. Voir : kubectl logs -n argocd deploy/argocd-image-updater-controller --since=1h | grep -i error"
fi

# ── 7. Disque ─────────────────────────────────────────────────────────────
use=$(df --output=pcent / | tail -1 | tr -dc '0-9')
(( use > DISK_MAX )) && add DISK 900 "Disque / a ${use}% (seuil ${DISK_MAX}%)."

# ── 8. Temperature — pas de ventilateur sur ce Pi ──────────────────────────
t=$(( $(cat /sys/class/thermal/thermal_zone0/temp 2>/dev/null || echo 0) / 1000 ))
(( t > TEMP_MAX )) && add TEMP 900 "CPU a ${t}°C (seuil ${TEMP_MAX}°C). Aucun ventilateur sur cette machine."

# ── 11. Resolution DNS du cluster ─────────────────────────────────────────
# Depuis le 2026-08-09, CoreDNS forwarde en DNS-over-TLS vers Cloudflare et
# n'est PLUS gere par k3s (coredns.yaml.skip). Deux consequences : si le DoT
# devient injoignable toute la resolution externe tombe, et plus aucune
# reconciliation automatique ne repare le Corefile. Ca se surveille.
if command -v nslookup >/dev/null 2>&1; then
  if ! timeout 8 nslookup kubernetes.default.svc.cluster.local 10.43.0.10 >/dev/null 2>&1; then
    add DNSINT 600 "Le DNS du cluster (10.43.0.10) ne resout plus les noms internes."
  elif ! timeout 8 nslookup github.com 10.43.0.10 >/dev/null 2>&1; then
    add DNSEXT 600 "Le DNS du cluster ne resout plus l'exterieur — le DNS-over-TLS vers Cloudflare (1.1.1.1:853) est probablement injoignable. Retour arriere : /etc/k3s-custom/coredns-cm-ORIGINAL.yaml"
  fi
fi

# ── 9. Sante du NVMe ──────────────────────────────────────────────────────
# Ce disque unique porte les donnees ET les sauvegardes : sa defaillance
# ferait tout perdre d'un coup. Il a deja encaisse 33 arrets brutaux.
if command -v nvme >/dev/null 2>&1 && [[ -e /dev/nvme0 ]]; then
  s=$(nvme smart-log /dev/nvme0 2>/dev/null)
  if [[ -n $s ]]; then
    val() { sed -n "s/^$1[^:]*:[[:space:]]*\([0-9]\+\).*/\1/p" <<<"$s" | head -1; }
    cw=$(val critical_warning); me=$(val media_errors)
    pu=$(val percentage_used);  sp=$(val available_spare)
    m=""
    (( ${cw:-0} != 0 )) && m+="critical_warning=$cw "
    (( ${me:-0} > 0 ))  && m+="media_errors=$me "
    (( ${pu:-0} > 80 )) && m+="usure=${pu}% "
    (( ${sp:-100} < 20 )) && m+="spare=${sp}% "
    [[ -n $m ]] && add NVME 900 "Sante NVMe degradee : $m— ce disque porte les donnees ET les sauvegardes."
  fi
fi

# ── 10. Fraicheur des sauvegardes ─────────────────────────────────────────
# Le CronJob peut echouer en silence : ce qui compte est l'archive produite.
newest=$(find /home/muchini/backups -maxdepth 1 -type f -name '*.tar.gz' \
         -printf '%T@\n' 2>/dev/null | sort -rn | head -1)
if [[ -z ${newest:-} ]]; then
  add BACKUP 0 "Aucune archive dans /home/muchini/backups."
else
  age=$(( NOW - ${newest%.*} ))
  (( age > 129600 )) && add BACKUP 0 "Derniere sauvegarde il y a $(( age / 3600 )) h (attendu : quotidienne a 03:00)."
fi

# ── 12. Sauvegarde coherente des bases (homelab-db-backup, 02:30) ──────────
# Complement de OnFailure= sur homelab-db-backup.service : un timer desactive
# ou une machine eteinte a 02:30 n'echouent pas, ils ne font rien. Seul l'age
# du dernier fichier produit le voit. Le seuil de 36 h tient lieu de grace.
if [[ ! -x $DB_BACKUP_DIR ]] && (( EUID != 0 )); then
  dbage="illisible sans root"           # --dry-run lance hors root
else
  dbnewest=$(find "$DB_BACKUP_DIR" -maxdepth 1 -type f -name 'k3s-state-*.db.gz' \
             -printf '%T@\n' 2>/dev/null | sort -rn | head -1)
  if [[ -z ${dbnewest:-} ]]; then
    dbage="aucune"
    add DBBACKUP 0 "Aucune sauvegarde k3s-state-*.db.gz dans $DB_BACKUP_DIR : le datastore k3s (etat du cluster + secrets) n'est plus sauvegarde."
  else
    dbage_s=$(( NOW - ${dbnewest%.*} ))
    dbage="il y a $(( dbage_s / 3600 )) h"
    (( dbage_s > DB_BACKUP_MAX_AGE )) && add DBBACKUP 0 "Derniere sauvegarde du datastore k3s ${dbage} (seuil $(( DB_BACKUP_MAX_AGE / 3600 )) h, attendu : quotidienne a 02:30). Voir : systemctl list-timers homelab-db-backup.timer ; journalctl -u homelab-db-backup -n 30"
  fi
fi

# ── 13. Pare-feu hote (homelab-fw.service) ────────────────────────────────
# Sa disparition (nft flush ruleset, echec au boot, service arrete) ne casse
# rien de visible : tout marche, tout est simplement expose. Lire les regles
# exige root : en --dry-run sous un autre utilisateur, le controle est saute.
# Sortie lue d'abord dans une variable : avec pipefail, "nft | grep -q" echoue
# quand grep sort au premier resultat et que nft prend un SIGPIPE (constate).
if (( EUID == 0 )); then
  fw_in=$(nft list chain inet homelab_fw input 2>/dev/null)
  fw_fwd=$(nft list chain inet homelab_fw forward 2>/dev/null)
  if ! grep -q 'policy drop;' <<<"$fw_in" || ! grep -q 'daddr 10.42.0.0/16 drop' <<<"$fw_fwd"; then
    add FIREWALL 600 "Pare-feu absent ou ouvert : table nftables inet homelab_fw introuvable, chaine input plus en policy drop ou regle forward vers les pods disparue. SSH, API k8s, kubelet, Plex et la WebUI sont exposes. Remede : systemctl restart homelab-fw ; nft list table inet homelab_fw"
  fi
fi

# ── 15. Unites homelab-* en echec ─────────────────────────────────────────
# Rattrape un echec que personne n'a signale : homelab-notify@ lui-meme en
# echec (ntfy injoignable au moment de l'alerte), ou une unite sans OnFailure=.
# 1 h de grace : OnFailure= a normalement deja prevenu.
bad=$(systemctl list-units --state=failed --plain --no-legend 'homelab-*' 2>/dev/null | awk '{printf "%s ",$1}')
[[ -n $bad ]] && add UNITFAIL 3600 "Unite(s) systemd en echec depuis >1 h : $bad— journalctl -u <unite> -n 50, puis systemctl reset-failed <unite>"

# ── Machine a etats ───────────────────────────────────────────────────────
declare -A SEEN
for i in "${ISSUES[@]}"; do SEEN[${i%%	*}]=$i; done

while IFS='|' read -r key first notified; do
  [[ -z ${key:-} ]] && continue
  if [[ -n ${SEEN[$key]:-} ]]; then
    IFS='	' read -r _ grace msg <<<"${SEEN[$key]}"
    if (( NOW - first >= grace )) && (( notified == 0 || NOW - notified >= REMINDER )); then
      notify urgent warning "🔴 $key" "$msg"; notified=$NOW
    fi
    printf '%s|%s|%s\n' "$key" "$first" "$notified" >>"$NEWSTATE"
    unset "SEEN[$key]"
  elif (( notified > 0 )); then
    notify default white_check_mark "✅ $key resolu" "L'anomalie $key a disparu apres $(( (NOW-first)/60 )) min."
  fi
done <"$STATE"

for key in "${!SEEN[@]}"; do printf '%s|%s|0\n' "$key" "$NOW" >>"$NEWSTATE"; done

sort -o "$NEWSTATE" "$NEWSTATE" 2>/dev/null || true
cp "$NEWSTATE" "$STATE"

# ── Battement de coeur quotidien ──────────────────────────────────────────
# Une sonde muette ne prouve rien : ce message quotidien rend le SILENCE
# remarquable (Pi eteint, timer arrete, script casse, ntfy injoignable).
# Envoye au premier passage apres HEARTBEAT_HOUR, une fois par jour ; si
# l'envoi echoue, il est retente au passage suivant. Jamais memorise en
# --dry-run.
HB_FILE="$STATE_DIR/heartbeat.last"
today=$(date +%F)
if (( FORCE_HB )) || { (( 10#$(date +%H) >= 10#$HEARTBEAT_HOUR )) && [[ $(cat "$HB_FILE" 2>/dev/null) != "$today" ]]; }; then
  if (( ${#ISSUES[@]} == 0 )); then
    hb_tag=green_heart;  hb_prio=low;     hb_title="homelab : tout va bien"
  else
    hb_tag=yellow_heart; hb_prio=default; hb_title="homelab : ${#ISSUES[@]} anomalie(s) en cours"
  fi
  up=$(cut -d. -f1 /proc/uptime)
  hb_body="Disque / ${use}% · CPU ${t}°C · sauvegarde k3s ${dbage} · en marche depuis $(( up / 86400 )) j $(( up % 86400 / 3600 )) h"
  (( ${#ISSUES[@]} )) && hb_body+=$'\n'"En cours : ${ISSUES[*]%%	*}"
  hb_body+=$'\n'"Prochain message demain apres ${HEARTBEAT_HOUR} h. Pas de message = la sonde ne tourne plus."
  if notify "$hb_prio" "$hb_tag" "$hb_title" "$hb_body" && (( ! DRY )); then
    echo "$today" >"$HB_FILE"
  fi
fi
[[ ${#ISSUES[@]} -eq 0 ]] && echo "OK — aucune anomalie" || printf 'ANOMALIES: %s\n' "${ISSUES[*]%%	*}"
