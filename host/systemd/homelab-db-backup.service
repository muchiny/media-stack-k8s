[Unit]
Description=Sauvegarde coherente des bases SQLite (datastore k3s + Plex)
Documentation=file:///usr/local/bin/homelab-db-backup
After=network-online.target
# Notification immediate en cas d'echec (copie invalide, sqlite3 en erreur,
# depassement de TimeoutStartSec). L'absence d'execution (timer arrete,
# machine eteinte) est couverte par le controle DBBACKUP de homelab-watch.
OnFailure=homelab-notify@%n.service

[Service]
Type=oneshot
# Fichiers crees en 600 meme si le script perdait son umask.
UMask=0077
ExecStart=/usr/local/bin/homelab-db-backup
# Volontairement PAS de dependance a k3s : state.db doit pouvoir etre sauvegarde
# meme quand le cluster est a terre -- c'est precisement la qu'on en a besoin.
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=600
