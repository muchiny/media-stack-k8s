[Unit]
Description=Notification ntfy : echec de %i
Documentation=file:///usr/local/bin/homelab-watch
# Declenchee par OnFailure=homelab-notify@%n.service dans l'unite surveillee
# (forme recommandee par systemd.exec(5) : une instance par unite surveillee,
# pour que systemd transmette MONITOR_* a la notification).
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# %i et non %I : %I "desechappe" les tirets en barres obliques
# (homelab-db-backup.service -> homelab/db/backup.service).
ExecStart=/usr/local/bin/homelab-watch --unit-failed %i
TimeoutStartSec=90
